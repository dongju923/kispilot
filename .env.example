# kispilot 환경변수 예시
#
# 키는 `kispilot setup` 으로 OS 키체인에 저장하는 것을 권장합니다.
# 키체인을 쓸 수 없는 환경(서버 등)에서만 이 파일을 복사해 .env 로 만들고 값을 채우세요.
#   cp .env.example .env        (Windows: copy .env.example .env)
# .env 는 .gitignore 에 들어 있습니다. 절대 커밋하거나 채팅창에 붙여넣지 마세요.
# 환경변수가 키체인보다 먼저 쓰입니다.

# ── 실전 계좌 ────────────────────────────────
REAL_APPKEY=
REAL_APP_SECRET=
# 계좌번호 앞 8자리
CANO=
# 계좌번호 뒤 2자리 (예: 01)
ACNT_PRDT_CD=

# ── 모의투자 계좌 ────────────────────────────
PAPER_APPKEY=
PAPER_APP_SECRET=
PAPER_CANO=
PAPER_ACNT_PRDT_CD=

# ── 선택 ─────────────────────────────────────
# AI 에이전트(MCP)의 실전 주문 허용. 켜도 2단계 확인을 거칩니다. 기본은 꺼짐
# KIS_ALLOW_REAL_ORDERS=1

# 데이터 폴더(토큰 캐시·종목 마스터·커스텀 전략) 위치 변경. 기본은 사용자 데이터 폴더
# KISPILOT_HOME=
